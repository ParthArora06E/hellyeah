# Auditor Configuration Environment Template
# Copy to .env and populate with your API keys (optional; scanner runs gracefully without keys)

# Application Settings
PROJECT_NAME="Auditor ASM & Vulnerability Risk Platform"
DATABASE_URL="sqlite:///./auditor.db"
SYNC_DATABASE_URL="sqlite:///./auditor.db"
DEMO_MODE=true

# External Threat Intelligence API Keys (optional; missing keys degrade gracefully)
SHODAN_KEY=""
SECURITYTRAILS_KEY=""
OTX_KEY=""
VIRUSTOTAL_KEY=""
URLSCAN_KEY=""
NVD_KEY=""

# Scanner Rates and Safety Defaults
REQUEST_TIMEOUT=15
MAX_CONCURRENCY=10
RATE_LIMIT_PER_SEC=5.0
PASSIVE_ONLY_DEFAULT=true

# Financial Cost Defaults
DEFAULT_DEV_HOURLY_RATE=85.0
DEFAULT_TESTER_HOURLY_RATE=65.0
DEFAULT_CURRENCY="USD"
DEFAULT_ASSET_VALUE=250000.0
DEFAULT_RECORDS_COUNT=50000

# Scheduled Monitoring & Alert Channels
# Email / SMTP Settings (Optional: captured to local outbox in DEMO_MODE)
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="alerts@auditor.local"

# Slack Incoming Webhook (Optional: captured to local outbox in DEMO_MODE)
SLACK_WEBHOOK_URL=""

# Telegram Bot (Optional)
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# Cryptographic Master Key (Fernet 32-byte key or passphrase; auto-derives if blank)
ENCRYPTION_KEY=""
